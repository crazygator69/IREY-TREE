:root{
  --safe-area-inset-top: env(safe-area-inset-top, 0px);
  --bg:#131312;
  --surface:#1b1b19;
  --surface-2:#232321;
  --line:#38352e;
  --ink:#f2eee5;
  --muted:#aaa495;
  --muted-2:#7e7a6f;
  --gold:#e2b95a;
  --gold-2:#f3d68b;
  --green:#48b478;
  --yellow:#e7c33d;
  --red:#e06a5a;
  --blue:#62a9e8;
}

@media (prefers-color-scheme: dark){
  :root{
    --bg:#131312;
    --surface:#1b1b19;
    --surface-2:#232321;
    --line:#38352e;
    --ink:#f2eee5;
    --muted:#aaa495;
    --gold:#e2b95a;
  }
}

*{
  box-sizing:border-box
}

html,body{
  margin:0;
  background:var(--bg);
  color:var(--ink)
}

body{
  font-family:"Avenir Next","Segoe UI",system-ui,-apple-system,sans-serif;
  line-height:1.45
}

.font-display{
  font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif
}

button,input{
  font:inherit
}

button{
  cursor:pointer
}

:focus-visible{
  outline:2px solid var(--gold);
  outline-offset:2px
}

.table-wrap{
  scrollbar-color:#4a463d transparent
}

.table-wrap::-webkit-scrollbar{
  height:10px
}

.table-wrap::-webkit-scrollbar-thumb{
  background:#4a463d;
  border-radius:99px
}

th{
  white-space:nowrap
}

@media (min-width: 640px) {
  .sm\:block {
    display: block;
  }

  .sm\:hidden {
    display: none;
  }

  .sm\:grid-cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .sm\:p-4 {
    padding: 1rem;
  }

  .sm\:px-6 {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .sm\:text-\[15px\] {
    font-size: 15px;
  }

  .sm\:text-\[38px\] {
    font-size: 38px;
  }
}

@media (min-width: 1024px) {
  .lg\:grid-cols-\[1\.15fr_\.85fr\] {
    grid-template-columns: 1.15fr .85fr;
  }

  .lg\:grid-cols-\[1fr_360px\] {
    grid-template-columns: 1fr 360px;
  }

  .lg\:flex-row {
    flex-direction: row;
  }

  .lg\:items-center {
    align-items: center;
  }
}
</style>
